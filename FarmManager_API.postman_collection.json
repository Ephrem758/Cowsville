          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/messages/",
            "description": "Get all messages. Can be filtered by farm_id and cow_id.",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001",
                "description": "Filter messages by farm ID"
              },
              {
                "key": "cow_id",
                "value": "COW001",
                "description": "Filter messages by cow ID (requires farm_id)"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Health Records",
      "item": [
        {
          "name": "List Health Records",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health/",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001"
              },
              {
                "key": "cow_id",
                "value": "COW001"
              }
            ]
          }
        },
        {
          "name": "Create Health Record",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/health/",
            "body": {
              "mode": "raw",
              "raw": {
                "cow": "COW001",
                "farm": "FARM001",
                "general_health": 1,
                "udder_health": 1,
                "mastitis": 1,
                "is_cow_vaccinated": true,
                "assessed_by": 1,
                "diagnosis": "Healthy",
                "treatment": "None required",
                "next_assessment_date": "2024-04-21"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Reproduction Records",
      "item": [
        {
          "name": "List Reproduction Records",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reproduction/",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001"
              },
              {
                "key": "is_pregnant",
                "value": "true"
              }
            ]
          }
        },
        {
          "name": "Create Reproduction Record",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/reproduction/",
            "body": {
              "mode": "raw",
              "raw": {
                "cow": "COW001",
                "farm": "FARM001",
                "is_cow_pregnant": true,
                "heat_sign_start": "2024-03-21T10:00:00Z",
                "pregnancy_date": "2024-03-21",
                "calving_date": "2024-12-21"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Medical Assessments",
      "description": "Endpoints for managing medical assessments by doctors and farmers",
      "item": [
        {
          "name": "Doctor's Medical Assessment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/medical-assessments/doctor_assessment/",
            "description": "Submit a comprehensive medical assessment by a veterinary doctor. Includes detailed health status, vaccination records, and treatment plans. Automatically notifies the farmer of the assessment results.",
            "body": {
              "mode": "raw",
              "raw": {
                "farm_id": "1",
                "cow_id": "8620",
                "doctor_id": 1,
                "is_cow_sick": true,
                "sickness_type": "infectious",
                "general_health": 1,
                "udder_health": 1,
                "mastitis": 1,
                "body_condition_score": 3,
                "reproductive_health": "Normal cycling",
                "metabolic_disease": "None observed",
                "is_cow_vaccinated": true,
                "vaccination_date": "2024-03-21",
                "vaccination_type": "FMD Vaccine",
                "has_deworming": true,
                "deworming_date": "2024-03-21",
                "deworming_type": "Albendazole",
                "diagnosis": "Mild infection",
                "treatment": "Antibiotics prescribed",
                "prescription": "Medication details",
                "next_assessment_date": "2024-04-21",
                "notes": "Follow up required"
              }
            }
          }
        },
        {
          "name": "Farmer's Medical Report",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/cows/farmer_medical_assessment/",
            "description": "Submit a medical report by a farmer",
            "body": {
              "mode": "raw",
              "raw": {
                "farm_id": "1",
                "cow_id": "8620",
                "sickness_description": "የወተት ነጭ ራሽ ባክቴሪያ ይታያል"
              }
            }
          }
        },
        {
          "name": "List Medical Assessments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/medical-assessments/",
            "description": "Get all medical assessments",
            "query": [
              {
                "key": "farm_id",
                "value": "1"
              },
              {
                "key": "cow_id",
                "value": "8620"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Heat Sign Monitoring",
      "description": "Endpoints for tracking heat signs and insemination records",
      "item": [
        {
          "name": "Monitor Heat Sign",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/cows/monitor_heat_sign/",
            "description": "Record heat sign monitoring by inseminator. Tracks insemination details, updates reproduction records, and sends notifications to relevant parties. Important for breeding management.",
            "body": {
              "mode": "raw",
              "raw": {
                "farm_id": "1",
                "cow_id": "8620",
                "is_inseminated": true,
                "insemination_time": "14:30",
                "insemination_count": 2,
                "lactation_number": 3
              }
            }
          }
        },
        {
          "name": "List Insemination Records",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/insemination-records/",
            "description": "Get all insemination records",
            "query": [
              {
                "key": "farm_id",
                "value": "1"
              },
              {
                "key": "cow_id",
                "value": "8620"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/messages/",
            "description": "Get all messages",
            "query": [
              {
                "key": "farm_id",
                "value": "1"
              },
              {
                "key": "message_type",
                "value": "health_alert"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Farmer Medical Reports",
      "description": "Endpoints for managing farmer-submitted medical reports",
      "item": [
        {
          "name": "List Farmer Reports",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/farmer-medical-reports/",
            "description": "Get all farmer medical reports. Can be filtered by farm_id, cow_id, and review status.",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001"
              },
              {
                "key": "cow_id",
                "value": "COW001"
              },
              {
                "key": "is_reviewed",
                "value": "false"
              }
            ]
          }
        },
        {
          "name": "Get Single Farmer Report",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/farmer-medical-reports/{id}/",
            "description": "Get details of a specific farmer medical report"
          }
        }
      ]
    },
    {
      "name": "Medical Assessments",
      "description": "Endpoints for managing doctor medical assessments",
      "item": [
        {
          "name": "List Medical Assessments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/medical-assessments/",
            "description": "Get all medical assessments. Can be filtered by farm_id, cow_id, doctor_id, and health status.",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001"
              },
              {
                "key": "cow_id",
                "value": "COW001"
              },
              {
                "key": "doctor_id",
                "value": "1"
              },
              {
                "key": "is_cow_sick",
                "value": "true"
              }
            ]
          }
        },
        {
          "name": "Get Single Assessment",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/medical-assessments/{id}/",
            "description": "Get details of a specific medical assessment"
          }
        }
      ]
    },
    {
      "name": "Insemination Records",
      "description": "Endpoints for managing insemination records",
      "item": [
        {
          "name": "List Insemination Records",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/insemination-records/",
            "description": "Get all insemination records. Can be filtered by farm_id, cow_id, and inseminator_id.",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001"
              },
              {
                "key": "cow_id",
                "value": "COW001"
              },
              {
                "key": "inseminator_id",
                "value": "1"
              },
              {
                "key": "is_inseminated",
                "value": "true"
              }
            ]
          }
        },
        {
          "name": "Get Single Record",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/insemination-records/{id}/",
            "description": "Get details of a specific insemination record"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
