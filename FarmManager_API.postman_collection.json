{
  "info": {
    "name": "Farm Manager API",
    "description": "Complete API documentation for Farm Management System. Includes endpoints for farm management, cow tracking, medical assessments, and more.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Farms",
      "description": "Endpoints for managing farms and their details",
      "item": [
        {
          "name": "List Farms",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/farms/",
            "description": "Get all registered farms. Can be filtered by farm_id, owner_name, or address. Returns basic farm information including assigned doctor and inseminator."
          }
        },
        {
          "name": "Create Farm",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/farms/",
            "description": "Register a new farm in the system. Requires farm identification, owner details, and farm infrastructure information. Optional: can assign doctor and inseminator during creation.",
            "body": {
              "mode": "raw",
              "raw": {
                "farm_id": "FARM001",
                "owner_name": "John Doe",
                "address": "Addis Ababa",
                "telephone_number": "+251912345678",
                "type_of_housing": 1,
                "type_of_floor": 1,
                "source_of_water": 1,
                "feeding_frequency": 1,
                "inseminator": 1,
                "doctor": 1
              }
            }
          }
        },
        {
          "name": "Change Farm's Doctor",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/farms/{farm_id}/change_doctor/",
            "body": {
              "mode": "raw",
              "raw": {
                "doctor_id": 1
              }
            }
          }
        }
      ]
    },
    {
      "name": "Cows",
      "item": [
        {
          "name": "List Cows",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/cows/",
            "query": [
              {
                "key": "farm_id",
                "value": "FARM001"
              }
            ]
          }
        },
        {
          "name": "Create Cow",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/cows/",
            "body": {
              "mode": "raw",
              "raw": {
                "farm": "FARM001",
                "cow_id": "COW001",
                "breed": 1,
                "age_in_days": 730,
                "sex": "F",
                "body_weight": 450.5,
                "bcs": 3.5,
                "gynecological_status": 1,
                "lactation_number": 2,
                "average_daily_milk": 25.5
              }
            }
          }
        },
        {
          "name": "Record Heat Sign",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/cows/record_heat_sign/",
            "description": "Record heat signs for a cow and notify relevant parties",
            "body": {
              "mode": "raw",
              "raw": {
                "farm_id": "FARM001",
                "cow_id": "COW001",
                "heat_signs": "Mounting behavior, Restlessness"
              }
            }
          }
        },
        {
          "name": "Monitor Pregnancy",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/cows/monitor_pregnancy/",
            "description": "Record or update pregnancy monitoring information",
            "body": {
              "mode": "raw",
              "raw": {
                "farm_id": "FARM001",
                "cow_id": "COW001",
                "is_pregnant": true,
                "lactation_number": 2
              }
            }
          },
          "response": [
            {
              "status": "200 OK",
              "body": {
                "message": "Pregnancy monitoring record updated successfully",
                "cow_id": "COW001",
                "farm_id": "FARM001",
                "is_pregnant": true,
                "lactation_number": 2
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors/"
          }
        },
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/doctors/",
            "body": {
              "mode": "raw",
              "raw": {
                "name": "Dr. John Smith",
                "phone_number": "+251912345678",
                "address": "Addis Ababa",
                "is_active": true,
                "specialization": "Veterinary Medicine",
                "license_number": "VET123"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Inseminators",
      "item": [
        {
          "name": "List Inseminators",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/inseminators/"
          }
        },
        {
          "name": "Create Inseminator",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/inseminators/",
            "body": {
              "mode": "raw",
              "raw": {
                "name": "John Doe",
                "phone_number": "+251912345678",
                "address": "Addis Ababa",
                "is_active": true,
                "license_number": "INS123"
              }
            }
          }
        },
        {
          "name": "Replace Inseminator",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/inseminators/{inseminator_id}/replace_inseminator/",
            "body": {
              "mode": "raw",
              "raw": {
                "name": "New Name",
                "phone_number": "+251912345678",
                "address": "New Address"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Choice Models",
      "item": [
        {
          "name": "List Breed Types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/breedtypes/"
          }
        },
        {
          "name": "List Housing Types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/housingtypes/"
          }
        },
        {
          "name": "List Floor Types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/floortypes/"
          }
        },
        {
          "name": "List Water Sources",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/watersources/"
          }
        },
        {
          "name": "List Feeding Frequencies",
          "request": {
            "method": "GET",
